[Unit]
Description=Discord Tournament Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/discord-tournament-bot
ExecStart=/home/ubuntu/discord-tournament-bot/start.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/discord-tournament-bot/bot.log
StandardError=append:/home/ubuntu/discord-tournament-bot/error.log

[Install]
WantedBy=multi-user.target